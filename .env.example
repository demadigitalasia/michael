# === Database ===
# Local dev (docker-compose): postgres://michael:lapidary_dev@localhost:5433/michael_lapidary
# Production (Coolify): postgres://USER:PASS@postgres-service:5432/michael_lapidary
DATABASE_URL="postgres://michael:lapidary_dev@localhost:5433/michael_lapidary"

# === Site ===
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Michael Lapidary"

# === Stripe (test mode dulu) ===
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# === Email (Resend) ===
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Michael Lapidary <orders@yourdomain.com>"
ADMIN_EMAIL="admin@michaellapidary.com"

# === Admin auth (generate: openssl rand -base64 32) ===
# AUTH_SECRET wajib ≥32 karakter di production — aplikasi menolak start tanpa itu.
AUTH_SECRET="ganti-dengan-string-acak-panjang"
# Password admin dipakai prisma/seed.ts saat membuat AdminUser (jangan pakai default!)
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# === Upload foto produk (disimpan di volume VPS) ===
UPLOAD_DIR="./uploads"
